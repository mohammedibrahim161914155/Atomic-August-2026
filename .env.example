# OPENROUTER_API_KEY: Required for AI API calls via OpenRouter.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# PORT: The port the server listens on. Defaults to 3000.
# PORT=3000

# MAX_CONCURRENT_GENERATIONS: Max simultaneous blueprint generations. Defaults to 3.
# MAX_CONCURRENT_GENERATIONS=3

# ALLOWED_ORIGIN: The exact origin browsers are allowed to connect from.
# Required in production — defaults to http://localhost:3000 with a warning.
# ALLOWED_ORIGIN=https://your-domain.com

# CONFIG_ENCRYPTION_KEY: 32-byte hex key for encrypting stored API keys at rest.
# Required in production. Generate with: openssl rand -hex 32
# CONFIG_ENCRYPTION_KEY=your_64_char_hex_here

# REDIS_URL: Persistent, replica-safe session storage.
# If omitted, local SQLite is used (cannot be shared across replicas).
# REDIS_URL=redis://localhost:6379

# ADMIN_TOKEN: Required to access /api/v1/sessions and /api/v1/metrics.
# Note: /api/v1/metrics exposes per-instance (in-memory) aggregates.
# If deploying multiple replicas, ping each instance separately or aggregate downstream.
# Generate with: openssl rand -hex 32
# ADMIN_TOKEN=your_secure_token_here

# TIMEOUT_FAST_MS: Generation timeout in ms for fast mode. Defaults to 300000 (5 min).
# TIMEOUT_FAST_MS=300000

# TIMEOUT_SAFE_MS: Generation timeout in ms for safe mode. Defaults to 720000 (12 min).
# TIMEOUT_SAFE_MS=720000

# TIMEOUT_RERUN_MS: Generation timeout in ms for reruns. Defaults to 480000 (8 min).
# TIMEOUT_RERUN_MS=480000

# MAX_TOKENS_PER_SESSION: Tokens allowed before terminating. Defaults to 500000.
# MAX_TOKENS_PER_SESSION=500000

# LOG_LEVEL: The Pino log level (fatal, error, warn, info, debug, trace). Defaults to 'info'.
# LOG_LEVEL=info

# SESSIONS_DIR: Directory for storing SQLite sessions. Defaults to ~/.atomic/sessions.
# SESSIONS_DIR=~/.atomic/sessions

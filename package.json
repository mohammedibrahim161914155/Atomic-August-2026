{
  "name": "atomic",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs --external:better-sqlite3 --external:vite",
    "build:mcp": "esbuild src/mcp/index.ts --bundle --platform=node --sourcemap --outfile=dist/mcp/index.js --format=esm",
    "start": "npm run build && NODE_ENV=production node dist/server.cjs",
    "start:prod": "NODE_ENV=production node dist/server.cjs",
    "deploy": "npm run build && npm run start:prod",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:http": "vitest run src/__tests__/http.test.ts --reporter=verbose",
    "test:all": "vitest run && npm run test:http",
    "verify-models": "tsx scripts/verify-models.ts",
    "mcp": "tsx src/mcp/index.ts",
    "mcp:http": "MCP_TRANSPORT=http tsx src/mcp/index.ts",
    "benchmark": "tsx benchmarks/benchmark.ts",
    "benchmark:dry": "tsx benchmarks/benchmark.ts --dry-run",
    "benchmark:update": "tsx benchmarks/benchmark.ts --update-baseline"
  },
  "bin": {
    "atomic-mcp": "./dist/mcp/index.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/deepseek": "^2.0.32",
    "@ai-sdk/google": "^3.0.67",
    "@ai-sdk/mistral": "^3.0.33",
    "@ai-sdk/openai": "^3.0.58",
    "@ai-sdk/xai": "^3.0.87",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.14",
    "@trigger.dev/sdk": "^4.4.5",
    "@vitejs/plugin-react": "^5.0.4",
    "ai": "^6.0.174",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^4.22.1",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.546.0",
    "marked": "^18.0.3",
    "motion": "^12.38.0",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "rate-limit-redis": "^4.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.2",
    "tsx": "^4.21.0",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^22.14.0",
    "@types/pino": "^7.0.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitest/coverage-v8": "^4.1.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.1",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.2",
    "vitest": "^4.1.2"
  }
}